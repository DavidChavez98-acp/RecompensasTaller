# ─────────────────────────────────────────────────────────────────────────────
# Recompensas Taller — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
#
# Las cinco primeras son OBLIGATORIAS en producción: el código lanza error si
# falta alguna. Perder PII_ENCRYPTION_KEY deja ilegibles las cédulas y los
# secretos de los dispositivos (los QR de todos los clientes dejarían de
# verificar). Guárdala fuera de Vercel también.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres. Debe ser la cadena de conexión con pooling.
POSTGRES_URL=

# Firma del JWT de sesión del PERSONAL INTERNO.
#   openssl rand -base64 32
ADMIN_SECRET=

# Firma del JWT de sesión del CLIENTE. DISTINTO del anterior a propósito:
# un token de cliente no debe poder tocar /interno ni por accidente.
#   openssl rand -base64 32
CLIENTE_SESSION_SECRET=

# AES-256-GCM para PII en reposo (cédula, email, teléfono, secreto del
# dispositivo que firma los códigos QR).
#   openssl rand -base64 32
PII_ENCRYPTION_KEY=

# HMAC de los índices ciegos. Rotarla rompe la búsqueda por cédula hasta
# recalcular todos los índices.
#   openssl rand -base64 32
PII_INDEX_KEY=

# ── Correo (OTP del cliente y avisos al taller) ──────────────────────────────
# Sin credenciales SMTP, en desarrollo los correos se vuelcan a
# .data/sent_emails.log — ahí se lee el código OTP para probar sin servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Recompensas Taller <no-reply@grupopalacios.com.ec>"

# ── Aplicación ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Siembra del primer Admin (pnpm db:seed). Idempotente: si el usuario ya
# existe, no se toca su contraseña.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Solo pruebas ─────────────────────────────────────────────────────────────
# Desactiva el rate limiting en memoria. NUNCA en producción.
# DISABLE_RATE_LIMIT=true
